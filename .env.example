# Question Vision Assistant — configuração de exemplo (TASK-001)
# Copiar para `.env` e ajustar. O `.env` real nunca é versionado.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Token opcional de autenticação (vazio = sem autenticação, apenas LAN).
AUTH_TOKEN=

# HTTPS — necessário para usar a câmera do telemóvel (CAMERA_TYPE=browser) via
# LAN; o browser bloqueia getUserMedia em http:// que não seja localhost.
# Gera um certificado self-signed em certs/ no primeiro arranque.
HTTPS=false

# ---------------------------------------------------------------------------
# Câmera (podes trocar em runtime na interface)
#   CAMERA_TYPE:
#     usb      webcam ligada ao servidor (índice CAMERA_DEVICE)
#     browser  a câmera do dispositivo que abre a interface (telemóvel);
#              o browser envia os frames, o servidor não abre hardware
#     rtsp     câmera IP por RTSP (CAMERA_URL)
#     http     câmera IP / telemóvel com app "IP Webcam" por HTTP-MJPEG (CAMERA_URL)
#     file     imagem de disco (TEST_IMAGE) — desenvolvimento sem câmera
# ---------------------------------------------------------------------------
CAMERA_TYPE=usb
CAMERA_DEVICE=0
# Usado quando CAMERA_TYPE=file (modo de desenvolvimento sem webcam):
TEST_IMAGE=tests/fixtures/question.jpg
# Usado quando CAMERA_TYPE=rtsp (fase 2):
CAMERA_URL=

# ---------------------------------------------------------------------------
# Serviço LLM (endpoint compatível com a API de chat completions da OpenAI).
#
# LLM_MODE:
#   ocr     imagem -> OCR (RapidOCR) -> texto -> modelo textual. Rápido em CPU,
#           mas só fiável com UMA questão limpa e enquadrada.
#   vision  imagem -> modelo multimodal. Lê o layout, mas lento em CPU local
#           (~2min); RÁPIDO e fiável com uma API cloud de visão.
#   hybrid  tenta ocr; se detetar alucinação, refaz com vision.
#
# --- RECOMENDADO: API cloud de visão (rápida, ~3s, lê folhas com várias
#     questões). A imagem só é enviada no momento da captura. ---
#
#   OpenRouter (muitos modelos, paga-se ao uso, ~$0.001/imagem):
#     LLM_MODE=vision
#     LLM_BASE_URL=https://openrouter.ai/api
#     LLM_API_KEY=sk-or-...
#     LLM_MODEL=google/gemini-2.0-flash-exp:free   (grátis) ou
#     LLM_MODEL=google/gemini-flash-1.5           (barato, muito bom)
#     LLM_SUPPORTS_VISION=true
#     LLM_TIMEOUT_SECONDS=30
#
#   Google Gemini (API direta):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_API_KEY=...
#     LLM_MODEL=gemini-1.5-flash
#
# --- 100% local (Ollama). Texto rápido, visão lenta. ---
#   Texto (LLM_MODE=ocr):
#     LLM_BASE_URL=http://localhost:11434
#     LLM_MODEL=qwen2.5:7b-instruct   (~25s, fiável)  ou  llama3.2:3b (~10s)
#     LLM_SUPPORTS_VISION=false
#   Visão (LLM_MODE=vision, ~2min/questão):
#     LLM_VISION_BASE_URL=http://localhost:11435
#     LLM_VISION_MODEL=qwen2.5vl:3b   (ou minicpm-v)
# ---------------------------------------------------------------------------
LLM_MODE=vision
LLM_BASE_URL=https://openrouter.ai/api
LLM_ENDPOINT=/v1/chat/completions
LLM_MODEL=google/gemini-2.0-flash-exp:free
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_SUPPORTS_VISION=true

# Serviço de visão separado para LLM_MODE=vision/hybrid (vazio = usa o de cima).
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=

# Modelos oferecidos no seletor da interface (vazio = todos os do serviço).
LLM_MODELS_ALLOWED=

# ---------------------------------------------------------------------------
# Deteção de mudança / captura automática (desligada por omissão no MVP)
# ---------------------------------------------------------------------------
AUTO_CAPTURE_ENABLED=false
CHANGE_THRESHOLD=0.25
STABILIZATION_MS=800

# ---------------------------------------------------------------------------
# Privacidade / histórico (local-first)
# ---------------------------------------------------------------------------
STORE_IMAGES=false
STORE_HISTORY=true
