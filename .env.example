# Question Vision Assistant — configuração de exemplo (TASK-001)
# Copiar para `.env` e ajustar. O `.env` real nunca é versionado.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Token opcional de autenticação (vazio = sem autenticação, apenas LAN).
AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Câmera
#   CAMERA_TYPE: usb | file | rtsp | http   (só `usb` e `file` no MVP)
# ---------------------------------------------------------------------------
CAMERA_TYPE=usb
CAMERA_DEVICE=0
# Usado quando CAMERA_TYPE=file (modo de desenvolvimento sem webcam):
TEST_IMAGE=tests/fixtures/question.jpg
# Usado quando CAMERA_TYPE=rtsp (fase 2):
CAMERA_URL=

# ---------------------------------------------------------------------------
# Serviço LLM local (não assumir fornecedor específico)
#
# Endpoint compatível com a API de chat completions da OpenAI (Ollama /v1,
# LM Studio, llama.cpp server, vLLM, ...).
#
#   LLM_SUPPORTS_VISION=true   -> modo A: a imagem vai direto ao modelo (Vision).
#   LLM_SUPPORTS_VISION=false  -> modo B: OCR (RapidOCR) -> texto -> modelo.
#                                No modo B, extração e resolução são fundidas
#                                numa só chamada ao LLM (menos latência em CPU).
#
# Exemplo Ollama de texto (modo B):
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=qwen2.5:7b-instruct
#   LLM_SUPPORTS_VISION=false
# Exemplo Ollama de visão (modo A):
#   LLM_MODEL=minicpm-v          (ou llava:7b)
#   LLM_SUPPORTS_VISION=true
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://host.docker.internal:11434
LLM_ENDPOINT=/v1/chat/completions
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_SUPPORTS_VISION=false

# ---------------------------------------------------------------------------
# Deteção de mudança / captura automática (desligada por omissão no MVP)
# ---------------------------------------------------------------------------
AUTO_CAPTURE_ENABLED=false
CHANGE_THRESHOLD=0.25
STABILIZATION_MS=800

# ---------------------------------------------------------------------------
# Privacidade / histórico (local-first)
# ---------------------------------------------------------------------------
STORE_IMAGES=false
STORE_HISTORY=true
